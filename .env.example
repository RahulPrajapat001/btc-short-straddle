# 1) Copy this file and name the copy ".env"  (just ".env", no .example)
# 2) Paste your Bybit API key and secret below (no quotes, no spaces)
# 3) Never share the .env file or upload it anywhere

# "testnet" (testnet.bybit.com keys) or "demo" (Bybit Demo Trading keys)
BYBIT_ENV=testnet

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
